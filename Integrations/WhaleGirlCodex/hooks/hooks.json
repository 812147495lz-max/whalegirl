    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/whalegirl_hook_bridge.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/whalegirl_hook_bridge.py\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
